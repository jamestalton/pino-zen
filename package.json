{
    "name": "pino-zen",
    "version": "4.0.1",
    "description": "Zen for Pino logging",
    "author": "James Talton <talton@gmail.com>",
    "license": "MIT",
    "type": "module",
    "homepage": "https://github.com/jamestalton/pino-zen#readme",
    "bugs": {
        "url": "https://github.com/jamestalton/pino-zen/issues"
    },
    "keywords": [
        "pino"
    ],
    "files": [
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/jamestalton/pino-zen.git"
    },
    "main": "./lib/pino-zen.js",
    "types": "./lib/pino-zen.d.ts",
    "exports": {
        ".": {
            "types": "./lib/pino-zen.d.ts",
            "default": "./lib/pino-zen.js"
        }
    },
    "bin": {
        "pino-zen": "lib/pino-zen-cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "npm run build && cat example.txt | node lib/pino-zen-cli.js -m module",
        "build": "rm -rf lib && tsc",
        "tsc": "tsc --noEmit",
        "lint": "biome check src tests",
        "format": "biome check --write src tests",
        "test": "npm run lint && npm run build && node --experimental-strip-types --test tests/*.test.ts"
    },
    "dependencies": {
        "chalk": "^6.0.1",
        "pino-abstract-transport": "^3.0.0",
        "sonic-boom": "^5.0.2",
        "split2": "^4.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@types/node": "^26.x.x",
        "@types/split2": "^4.2.3",
        "pino": "^10.4.0",
        "typescript": "^7.0.2"
    }
}
